# Base de datos PostgreSQL (Render en produccion, Docker local en desarrollo)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rentafacil

# JWT usado por el AuthDemoController local (equivalente al OAuth2 authorization server)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=1d

# Aplicacion
PORT=3000
NODE_ENV=development

# URL del frontend (Vercel en produccion) usada para el filtro CORS
FRONTEND_URL=http://localhost:5173

# Opcionales (contrato autos-openapi.yaml)
# Limite de peticiones por minuto y afiliado en /search (responde 429 + Retry-After)
RATE_LIMIT_PER_MINUTE=120
# Valor de la cabecera X-API-Deprecation-Date (fecha prevista de baja de la v1)
API_DEPRECATION_DATE=2027-12-31

# Reto 2 (/api/v2) — integracion con el Booking Prototipo central
# RabbitMQ (exchange topic booking.events). Vacio = bus deshabilitado (modo degradado: solo log + outbox)
RABBITMQ_URL=
# Cada cuanto el worker del outbox publica los eventos pendientes (ms)
OUTBOX_INTERVAL_MS=5000
# Servidor gRPC inventory.InventoryStockService (mismo proceso que el HTTP). false para apagarlo
GRPC_ENABLED=true
GRPC_PORT=50051
# InventoryStockService del Booking central para PushStockUpdate (ej. localhost:50052 o booking.epn.edu.ec:50051)
BOOKING_GRPC_URL=
BOOKING_GRPC_TLS=false
# X-API-Key aceptada para llamadas M2M del Booking (rol B2B). Vacio = solo JWT
BOOKING_API_KEY=
