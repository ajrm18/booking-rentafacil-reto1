# ═══ RentaFacil EC - Autos API v3 (Reto 2 final) ═══
# En Azure: App Service -> Configuration -> Application settings (mismas claves).

# Base de datos — Supabase Session pooler (IPv4, compatible con Azure). Si la contrasena tiene
# @ # / ? & = + % aplicar percent-encoding (@ -> %40, # -> %23, / -> %2F ...).
SUPABASE_URL=postgresql://postgres.<PROJECT_REF>:<TU_PASSWORD_SUPABASE_AQUI>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Respaldo si no hay SUPABASE_URL (Neon / Docker local)
DATABASE_URL=${SUPABASE_URL}
# DB_SYNCHRONIZE=false   (por defecto true: TypeORM crea/actualiza las tablas de los 9 esquemas)
# DB_POOL_MAX=5

# Bus de eventos — CloudAMQP
RABBITMQ_URL=amqps://<usuario>:<TU_PASSWORD_RABBITMQ_AQUI>@leopard.lmq.cloudamqp.com/<vhost>
EVENT_BUS_MODE=rabbitmq
OUTBOX_INTERVAL_MS=5000

# Booking Prototipo Central
BOOKING_BASE_URL=https://booking-core-api.azurewebsites.net/api/v3
BOOKING_REST_STOCK_URL=https://rda1-backend-integracion-sistemas.onrender.com/api/v3/inventory/stock
BOOKING_CHECKIN_URL=https://booking-core-api.azurewebsites.net/api/v3/reservas
BOOKING_GRPC_HOST=rda1-backend-integracion-sistemas.onrender.com:50051
BOOKING_GRPC_TLS=false
# Clave que entrega el profesor al registrar el proveedor. Mientras diga PENDIENTE... se toleran las
# X-API-Key que envie el Booking (con WARN en el log).
BOOKING_API_KEY=PENDIENTE_ME_LA_DARA_EL_PROFESOR

# Identidad propia (debe coincidir con /health y /promociones)
NODE_ID=NODE_AUT_RENTAFACIL
PROVIDER_NAME=RentaFacil EC
VERTICAL=AUTOS
PROVIDER_VERSION=3.0.0
PUBLIC_BASE_URL=https://rentafacil-autos-api.azurewebsites.net

# Seguridad
JWT_SECRET=<openssl rand -hex 32>
JWT_EXPIRES_IN=1d
API_KEY_INTERNAL=<openssl rand -hex 24>

# Servidor gRPC propio (en Azure B1 el puerto 50051 no es publico: false = solo cliente hacia el Booking)
GRPC_ENABLED=false
GRPC_PORT=50051

# Seed idempotente al arrancar (12 autos, usuarios demo, contrato B2B)
SEED_ON_START=true

# Azure App Service
NODE_ENV=production
PORT=8080
WEBSITES_CONTAINER_START_TIME_LIMIT=600
SCM_DO_BUILD_DURING_DEPLOYMENT=false
ENABLE_ORYX_BUILD=false

# Frontend
FRONTEND_URL=https://booking-rentafacil-reto1.vercel.app

# Opcionales del contrato v1
RATE_LIMIT_PER_MINUTE=120
API_DEPRECATION_DATE=2027-12-31
