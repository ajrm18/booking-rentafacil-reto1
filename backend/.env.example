# Base de datos PostgreSQL (Render en produccion, Docker local en desarrollo)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rentafacil

# JWT usado por el AuthDemoController local (equivalente al OAuth2 authorization server)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=1d

# Aplicacion
PORT=3000
NODE_ENV=development

# URL del frontend (Vercel en produccion) usada para el filtro CORS
FRONTEND_URL=http://localhost:5173

# Opcionales (contrato autos-openapi.yaml)
# Limite de peticiones por minuto y afiliado en /search (responde 429 + Retry-After)
RATE_LIMIT_PER_MINUTE=120
# Valor de la cabecera X-API-Deprecation-Date (fecha prevista de baja de la v1)
API_DEPRECATION_DATE=2027-12-31
