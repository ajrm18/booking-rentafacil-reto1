{
  "name": "rentafacil-autos-api",
  "version": "2.0.0",
  "description": "RentaFacil EC - Proveedor de Autos del Booking Prototipo. Reto 1: contracts/autos-openapi.yaml (/api/v1). Reto 2: contracts/autos-openapi-v2.yaml (/api/v2), gRPC InventoryStockService :50051 y CloudEvents a RabbitMQ",
  "author": "Anthony Rosero",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node -r tsconfig-paths/register src/modules/autos/seeds/seed.ts",
    "seed:prod": "node dist/modules/autos/seeds/seed.js",
    "start:render": "node dist/modules/autos/seeds/seed.js && node dist/main.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:e2e": "jest --runInBand --selectProjects e2e",
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "build:contrato-v2": "node scripts/build-contrato-propio-v2.mjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.7.15",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/typeorm": "^10.0.1",
    "amqplib": "^0.10.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "js-yaml": "^4.3.2",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.19"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.4.22",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": "22.x"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "rootDir": ".",
        "testMatch": [
          "<rootDir>/test/unit/**/*.spec.ts"
        ],
        "setupFiles": [
          "<rootDir>/test/setup-env.ts"
        ]
      },
      {
        "displayName": "e2e",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "rootDir": ".",
        "testMatch": [
          "<rootDir>/test/e2e/**/*.e2e-spec.ts"
        ],
        "setupFiles": [
          "<rootDir>/test/setup-env.ts"
        ]
      }
    ],
    "testTimeout": 60000
  }
}
