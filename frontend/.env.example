# URL del backend (Azure App Service en produccion, localhost en desarrollo). Puede terminar en
# /api/v1, /api/v2 o /api/v3: el cliente deriva las tres bases. Produccion:
# VITE_API_URL=https://rentafacil-autos-api.azurewebsites.net/api/v3
VITE_API_URL=http://localhost:3000/api/v1

# X-Affiliate-Id requerido por el contrato (integer positivo)
VITE_AFFILIATE_ID=1

# Opcional: base de /api/v2 (por defecto VITE_API_URL con /api/v1 -> /api/v2)
# VITE_API_V2_URL=http://localhost:3000/api/v2
